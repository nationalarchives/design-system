---
title: Textarea with a character count
layout: examples/plain.njk
private: true
---

{% from "nationalarchives/components/textarea/macro.njk" import tnaTextarea %}

<div class="tna-container">
  <div class="tna-column tna-column--width-1-3 tna-column--full-small tna-column--full-tiny tna-!--margin-vertical-m">
    {{ tnaTextarea({
      label: "Enter text (length)",
      id: "input1",
      name: "input1",
      value: "I ❤️ design",
      rows: 2,
      characterCount: {
        max: 100,
        debounceDuration: 100
      }
    }) }}
  </div>
  <div class="tna-column tna-column--width-1-3 tna-column--full-small tna-column--full-tiny tna-!--margin-vertical-m">
    {{ tnaTextarea({
      label: "Enter text (characters)",
      id: "input2",
      name: "input2",
      value: "I ❤️ design",
      rows: 2,
      characterCount: {
        max: 100,
        countType : "characters",
        debounceDuration: 100
      }
    }) }}
  </div>
  <div class="tna-column tna-column--width-1-3 tna-column--full-small tna-column--full-tiny tna-!--margin-vertical-m">
    {{ tnaTextarea({
      label: "Enter text (words)",
      id: "input3",
      name: "input3",
      value: "I ❤️ design",
      rows: 2,
      characterCount: {
        max: 10,
        countType : "words",
        debounceDuration: 100
      }
    }) }}
  </div>
</div>

<script>
  const inputs = [
    document.getElementById("input1"),
    document.getElementById("input2"),
    document.getElementById("input3")
  ];
  const update = (event) => {
    inputs
      .filter(input => input !== event.target)
      .forEach(input => {
        input.value = event.target.value;
        input.dispatchEvent(new Event("focus"));
      })
  }
  inputs.forEach(input => {
    input.addEventListener("input", update);
  });
</script>
